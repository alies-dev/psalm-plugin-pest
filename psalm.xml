<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    cacheDirectory=".cache/psalm"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    findUnusedPsalmSuppress="true"
>
    <projectFiles>
        <directory name="src" />
    </projectFiles>

    <!-- Psalm exposes function and class storage only through its @internal providers. This list is
         the plugin's whole dependency on Psalm internals: review it on every Psalm major. -->
    <issueHandlers>
        <InternalMethod>
            <errorLevel type="suppress">
                <referencedMethod name="Psalm\Internal\Analyzer\StatementsAnalyzer::getNodeTypeProvider" />
                <referencedMethod name="Psalm\Internal\Codebase\Functions::functionExists" />
                <referencedMethod name="Psalm\Internal\Codebase\Functions::getFullyQualifiedFunctionNameFromString" />
                <referencedMethod name="Psalm\Internal\Codebase\Functions::getStorage" />
                <referencedMethod name="Psalm\Internal\Codebase\Functions::hasStubbedFunction" />
                <referencedMethod name="Psalm\Internal\MethodIdentifier::__construct" />
                <referencedMethod name="Psalm\Internal\Provider\ClassLikeStorageProvider::get" />
                <referencedMethod name="Psalm\Internal\Provider\ClassLikeStorageProvider::has" />
                <referencedMethod name="Psalm\Internal\Provider\FileProvider::getContents" />
                <referencedMethod name="Psalm\Internal\Provider\FunctionParamsProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\FunctionReturnTypeProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\MethodParamsProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\MethodReturnTypeProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\MethodVisibilityProvider::has" />
                <referencedMethod name="Psalm\Internal\Provider\MethodVisibilityProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\NodeDataProvider::getType" />
                <referencedMethod name="Psalm\Internal\Provider\PropertyExistenceProvider::has" />
                <referencedMethod name="Psalm\Internal\Provider\PropertyExistenceProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\PropertyTypeProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\PropertyVisibilityProvider::registerClosure" />
            </errorLevel>
        </InternalMethod>
        <InternalProperty>
            <errorLevel type="suppress">
                <referencedProperty name="Psalm\Internal\Codebase\Functions::$params_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Functions::$return_type_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Methods::$params_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Methods::$return_type_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Methods::$visibility_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Properties::$property_existence_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Properties::$property_type_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Properties::$property_visibility_provider" />
                <referencedProperty name="Psalm\Internal\MethodIdentifier::$fq_class_name" />
                <referencedProperty name="Psalm\Internal\MethodIdentifier::$method_name" />
            </errorLevel>
        </InternalProperty>
        <InternalClass>
            <errorLevel type="suppress">
                <referencedClass name="Psalm\Internal\Analyzer\ClassLikeAnalyzer" />
                <referencedClass name="Psalm\Internal\MethodIdentifier" />
            </errorLevel>
        </InternalClass>
    </issueHandlers>
</psalm>
