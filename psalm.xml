<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    cacheDirectory=".cache/psalm"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    findUnusedPsalmSuppress="true"
>
    <projectFiles>
        <directory name="src" />
    </projectFiles>

    <!-- Psalm exposes function and class storage only through its @internal providers. This list is
         the plugin's whole dependency on Psalm internals: review it on every Psalm major. -->
    <issueHandlers>
        <InternalMethod>
            <errorLevel type="suppress">
                <referencedMethod name="Psalm\Internal\Codebase\Functions::getStorage" />
                <referencedMethod name="Psalm\Internal\Codebase\Functions::hasStubbedFunction" />
                <referencedMethod name="Psalm\Internal\Provider\ClassLikeStorageProvider::get" />
                <referencedMethod name="Psalm\Internal\Provider\ClassLikeStorageProvider::has" />
                <referencedMethod name="Psalm\Internal\Provider\FileProvider::getContents" />
                <referencedMethod name="Psalm\Internal\Provider\FunctionParamsProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\FunctionReturnTypeProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\PropertyExistenceProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\PropertyTypeProvider::registerClosure" />
                <referencedMethod name="Psalm\Internal\Provider\PropertyVisibilityProvider::registerClosure" />
            </errorLevel>
        </InternalMethod>
        <InternalProperty>
            <errorLevel type="suppress">
                <referencedProperty name="Psalm\Internal\Codebase\Functions::$params_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Functions::$return_type_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Properties::$property_existence_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Properties::$property_type_provider" />
                <referencedProperty name="Psalm\Internal\Codebase\Properties::$property_visibility_provider" />
            </errorLevel>
        </InternalProperty>
    </issueHandlers>
</psalm>
